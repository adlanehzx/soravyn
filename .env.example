DATABASE_URL=postgres://soravyn:soravyn@localhost:5432/soravyn
PORT=3200
SERVE_UI=false

# Video API and worker must share this absolute directory and DATABASE_URL.
# SORAVYN_VIDEO_ROOT=/absolute/path/to/soravyn/data/video
SORAVYN_VIDEO_IMAGE=soravyn-video:0.6.91

# Optional local-only script generation; use an already installed Ollama model.
# Set the same values in the API and video worker environments.
SORAVYN_OLLAMA_URL=http://127.0.0.1:11434
# SORAVYN_OLLAMA_MODEL=your-installed-model

# Optional: limit this video worker to one client UUID (also useful for isolated smoke checks).
# SORAVYN_VIDEO_COMPANY_ID=

# Admission quotas, shared by all API/worker instances using the database.
SORAVYN_MAX_AGENT_RUNS=8
SORAVYN_MAX_VIDEO_RUNS=2
# Native PostgreSQL client compatible with the database server major version.
# SORAVYN_PG_DUMP_PATH=/usr/bin/pg_dump
