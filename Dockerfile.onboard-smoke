FROM ubuntu:24.04

ARG NODE_MAJOR=20
ARG SORAVYNAI_VERSION=latest
ARG HOST_UID=10001

ENV DEBIAN_FRONTEND=noninteractive \
  SORAVYN_HOME=/soravyn \
  SORAVYN_OPEN_ON_LISTEN=false \
  HOST=0.0.0.0 \
  PORT=3200 \
  HOME=/home/soravyn \
  LANG=en_US.UTF-8 \
  LC_ALL=en_US.UTF-8 \
  NPM_CONFIG_UPDATE_NOTIFIER=false \
  NODE_MAJOR=${NODE_MAJOR} \
  SORAVYNAI_VERSION=${SORAVYNAI_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg locales \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && locale-gen en_US.UTF-8 \
  && groupadd --gid 10001 soravyn \
  && useradd --create-home --shell /bin/bash --uid "${HOST_UID}" --gid 10001 soravyn \
  && mkdir -p /soravyn /home/soravyn/workspace \
  && chown -R soravyn:soravyn /soravyn /home/soravyn \
  && rm -rf /var/lib/apt/lists/*

VOLUME ["/soravyn"]
WORKDIR /home/soravyn/workspace
EXPOSE 3200
USER soravyn

CMD ["bash", "-lc", "set -euo pipefail; mkdir -p \"$SORAVYN_HOME\"; npx --yes \"soravyn@${SORAVYNAI_VERSION}\" onboard --yes --data-dir \"$SORAVYN_HOME\""]
