{
  "name": "soravyn-workspace",
  "description": "SORAVYN \u2014 Autonomous Creative Intelligence",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs watch",
    "dev:watch": "SORAVYN_MIGRATION_PROMPT=never node scripts/dev-runner.mjs watch",
    "dev:once": "node scripts/dev-runner.mjs dev",
    "dev:server": "pnpm --filter @soravyn/server dev",
    "dev:ui": "pnpm --filter @soravyn/ui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=2",
    "db:generate": "pnpm --filter @soravyn/db generate",
    "db:migrate": "pnpm --filter @soravyn/db migrate",
    "secrets:migrate-inline-env": "tsx scripts/migrate-inline-env-secrets.ts",
    "db:backup": "./scripts/backup-db.sh",
    "soravyn": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts",
    "build:npm": "./scripts/build-npm.sh",
    "release": "./scripts/release.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check:tokens": "node scripts/check-forbidden-tokens.mjs",
    "docs:dev": "cd docs && npx mintlify dev",
    "smoke:openclaw-join": "./scripts/smoke/openclaw-join.sh",
    "smoke:openclaw-docker-ui": "./scripts/smoke/openclaw-docker-ui.sh",
    "smoke:openclaw-sse-standalone": "./scripts/smoke/openclaw-sse-standalone.sh",
    "video:worker": "pnpm --filter @soravyn/server video:worker",
    "video:image": "docker build -t soravyn-video:0.6.91 -f docker/video/Dockerfile .",
    "flow:worker": "pnpm --filter @soravyn/server flow:worker",
    "flow:login": "pnpm --filter @soravyn/server flow:worker --login",
    "flow:import": "pnpm --filter @soravyn/server flow:import"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4"
}
